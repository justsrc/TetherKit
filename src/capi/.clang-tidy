# Check exemptions for the C ABI implementation layer
#
# Same reasoning as include/tetherkit/capi/.clang-tidy: the exported function
# names must follow the C convention `tk_snake_case`, and the implementation
# unavoidably contains C-style fixed-length buffer copies and raw pointers.
InheritParentConfig: true

Checks: >
  -readability-identifier-naming,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-member-init,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp
