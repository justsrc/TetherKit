# TetherKit code formatting configuration.
# Google style as the baseline, with line width relaxed to 100 columns to fit
# protocol constant tables and long type names.
---
Language: Cpp
BasedOnStyle: Google
Standard: c++20

ColumnLimit: 100
IndentWidth: 2
TabWidth: 2
UseTab: Never
AccessModifierOffset: -1

# Pointer/reference hugs the type: TetherKit writes `Foo* p`, not `Foo *p`
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left

# Braces: function and control-flow opening braces stay on the same line (Attach)
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
InsertBraces: true

# Constructor initializer lists: one base per line to keep diffs readable
BreakConstructorInitializers: BeforeColon
ConstructorInitializerAllOnOneLineOrOnePerLine: true
PackConstructorInitializers: NextLine

# Include-group order: project headers > third party > system/platform > stdlib
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"tetherkit/'
    Priority: 1
  - Regex: '^<(doctest|libusb)'
    Priority: 2
  - Regex: '^<(sys|net|netinet|mach|pthread|IOKit|CoreFoundation)/'
    Priority: 3
  - Regex: '^<[a-z_]+\.h>'
    Priority: 3
  - Regex: '^<'
    Priority: 4
  - Regex: '.*'
    Priority: 5

# Misc
AlwaysBreakTemplateDeclarations: Yes
EmptyLineBeforeAccessModifier: LogicalBlock
FixNamespaceComments: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SeparateDefinitionBlocks: Always
SpacesBeforeTrailingComments: 2
QualifierAlignment: Left
