<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Info.plist template for TetherKit.app.

  Scripts/build-gui.sh replaces __TETHERKIT_VERSION__ with the real version
  number and copies the file into TetherKit.app/Contents/.

  The app itself needs **no entitlements at all**: it runs as an ordinary
  user, touches neither USB nor the interface, and hands every privileged
  operation to tetherkit-helper over XPC.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>TetherKit</string>
    <key>CFBundleDisplayName</key>
    <string>TetherKit</string>
    <key>CFBundleIdentifier</key>
    <string>com.tetherkit.app</string>
    <key>CFBundleExecutable</key>
    <string>TetherKit</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- The icon for the Dock and Finder. Resources/AppIcon.icns is
         copied in by build-gui.sh. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleShortVersionString</key>
    <string>__TETHERKIT_VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__TETHERKIT_VERSION__</string>

    <!-- The interface languages declared here.
         The strings themselves are compiled into the binary (see
         TetherKitIPC/Localization.swift for why they do not go through
         .lproj), so this **does not** affect what is actually displayed:
         its purpose is to let "System Settings, General, Language and
         Region, Applications" list TetherKit and offer these two
         options. The in-app language menu is independent of this entry;
         both work. The first entry also serves as the
         CFBundleDevelopmentRegion. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
    </array>

    <!-- Swift's Observation and ContentUnavailableView need macOS 14.
         The command line part still supports 13.3; the two are
         independent artifacts. -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- This is an ordinary app with a window, not a background agent. -->
    <key>LSUIElement</key>
    <false/>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <!-- Being automatically terminated by the system while a session
         runs is the same as cutting the user's network. -->
    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
