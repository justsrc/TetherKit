<?xml version="1.0" encoding="UTF-8"?>
<!--
  The LaunchDaemon configuration of tetherkit-helper.

  Installed to /Library/LaunchDaemons/com.tetherkit.helper.plist (root
  required). Scripts/install-helper.sh does it for you.

  Why a classic LaunchDaemon rather than SMAppService:
    SMAppService binds the App and the helper bidirectionally through the
    code signing designated requirement, and under source distribution
    every machine compiles a different cdhash, so the DR can never match.
    It also does not raise a password dialog: the approval entry point is
    "System Settings, Login Items and Extensions", which is awkward for
    a tool installed from the command line.
    See docs/GUI-SPIKE.md section 3.3.

  Why there is no KeepAlive:
    Once MachServices is declared, launchd starts the service **on
    demand** when somebody connects to it. Adding KeepAlive only makes it
    resident while nobody uses it, wasting memory, and once the helper is
    running it stays alive (see the note at the end of main.swift), so
    launchd does not need to restart it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tetherkit.helper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.tetherkit.helper</string>
    </array>

    <!-- Declares the Mach service; launchd starts it on demand. The
         name must be exactly HelperConstants.machServiceName. -->
    <key>MachServices</key>
    <dict>
        <key>com.tetherkit.helper</key>
        <true/>
    </dict>

    <!-- The log. The helper's own problems (does not start, crashes)
         can only be seen here. -->
    <key>StandardOutPath</key>
    <string>/var/log/tetherkit-helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/tetherkit-helper.log</string>

    <!-- The data path opens BPF descriptors and many USB transfers, so
         the default of 256 descriptors is too tight. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>
